ENVIRONMENT=development
KCOS_INSTANCE_ID=kcos-01
KCOS_RUNTIME_DIR=.kcos/runtime
KCOS_REQUIRE_ADMIN_TOKEN_REMOTE=true
MAX_CONCURRENT_DECISIONS=16
HEARTBEAT_SECONDS=6
MAX_DECISION_STALENESS_SECONDS=6
LIVE_TRADING_ENABLED=false
AUTO_GRADUATE_TO_LIVE=false
INITIAL_CAPITAL=1000
BASE_CURRENCY=USD
OWNER_JURISDICTION=US

DATABASE_URL=postgresql://kcos:kcos@postgres:5432/kcos
REDIS_URL=redis://redis:6379/0
SECRET_BACKEND=env

KRONOS_ENABLED=true
KRONOS_MODEL=NeoQuasar/Kronos-base
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cpu
KRONOS_MIN_BARS=64
KRONOS_INTERVAL_SECONDS=60
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=12
KRONOS_SAMPLE_COUNT=5
HF_TOKEN=

DATABENTO_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=KCOS/1.0 owner@example.com

IBKR_ENABLED=false
IBKR_BASE_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
IBKR_BEARER_TOKEN=
IBKR_VERIFY_TLS=false   # Set to true with a valid cert before any internet-facing live trading connection
IBKR_INSTRUMENTS=

COINBASE_ENABLED=false
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_PORTFOLIO_ID=
COINBASE_SYMBOLS=BTC-USD

OANDA_ENABLED=false
OANDA_BASE_URL=https://api-fxtrade.oanda.com
OANDA_STREAM_URL=https://stream-fxtrade.oanda.com
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=

MAX_RISK_PER_TRADE_PCT=0.50
MAX_AGGREGATE_OPEN_RISK_PCT=2.00
MAX_DAILY_LOSS_PCT=1.00
MAX_WEEKLY_LOSS_PCT=3.00
DRAWDOWN_WARNING_PCT=5.00
HARD_DRAWDOWN_STOP_PCT=10.00
MAX_GROSS_LEVERAGE=1.00
MAX_SINGLE_ASSET_NOTIONAL_PCT=20.00
MAX_VENUE_EXPOSURE_PCT=50.00
MIN_SIGNAL_CONFIDENCE=0.60

ALERT_WEBHOOK_URL=
OWNER_EMAIL=

# ---------- Streaming universe ----------
DATABENTO_DATASET=
DATABENTO_SCHEMA=trades
DATABENTO_SYMBOLS=
OANDA_SYMBOLS=EUR_USD

# ---------- Optional reasoning layer ----------
# OpenAI-compatible endpoint. Research only; never receives raw credentials.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
